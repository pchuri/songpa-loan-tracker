<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- A self-signed identity carries no Team ID, so the hardened runtime's
         library validation refuses to load the bundled libpython and Qt
         frameworks ("mapping process and mapped file have different Team IDs").
         Disabling library validation is what makes a locally signed build
         runnable; a notarized Developer ID build would not need this. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
